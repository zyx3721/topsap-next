{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TopSAP Client",
  "mainBinaryName": "topsap-client",
  "version": "1.6.0",
  "identifier": "dev.topsap.next",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "TopSAP Client",
        "width": 1080,
        "height": 720,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "backgroundColor": "#0b0f14"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["resources/wintun.dll", "resources/wintun-arm64.dll"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
